{
  "manifest_version": 3,
  "name": "YouTube Study Focus",
  "version": "1.0.0",
  "description": "Hide YouTube recommendations and comments while you study.",
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
